# Copy this file to .env.local and fill in values from your Neon database.
NODE_ENV=development

# Get the connection string from the Neon console directly.

DATABASE_URL=
INIT_SECRET=
SEED_DEMO_DATA=false
SEED_DEMO_USERS=false
DEMO_USER_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_FULL_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_WHATSAPP_PHONE=
ADMIN_WHATSAPP_LABEL=אמיר

# Cloudinary — signed image uploads for product photos. Copy from the
# Cloudinary console (Dashboard → Account details). API secret is server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared secret for the LAN print bridge. Set a separate strong value on Render.
BRIDGE_SECRET=
