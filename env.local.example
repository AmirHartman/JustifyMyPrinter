# Copy this file to .env.local and fill in values from your Neon database.
NODE_ENV=development

# Local 3MF estimate sync (the password stays only in your local .env.local).
JMP_SERVER_URL=http://127.0.0.1:3000
JMP_ADMIN_USERNAME=
JMP_ADMIN_PASSWORD=
# PRINT_FILES_DIR and PRINT_FILES_MANIFEST are optional; defaults are under print-files/.
# Get the connection string from the Neon console directly.

DATABASE_URL=
INIT_SECRET=
SEED_DEMO_DATA=false
SEED_DEMO_USERS=false
DEMO_USER_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_FULL_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_WHATSAPP_PHONE=
ADMIN_WHATSAPP_LABEL=אמיר
