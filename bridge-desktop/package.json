{
  "name": "jmp-bridge-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop controller for the JustifyMyPrinter local bridge.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/management-client.js && node --check src/config-store.js && node --check src/renderer/app.js",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.justifymyprinter.bridge.desktop",
    "productName": "מדפסת חברים – גשר מקומי",
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "directories": { "buildResources": "assets" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "perMachine": false,
      "allowElevation": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
