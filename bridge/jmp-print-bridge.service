[Unit]
Description=JustifyMyPrinter outbound local print bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/ABSOLUTE/PATH/TO/bridge
EnvironmentFile=/ABSOLUTE/PATH/TO/bridge/.env
ExecStart=/usr/bin/node /ABSOLUTE/PATH/TO/bridge/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
