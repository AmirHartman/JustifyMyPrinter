# ── JustifyMyPrinter local bridge configuration ──
# Copy to .env and fill in. Run with:  node --env-file=.env index.js

# The deployed site (Render URL), or http://localhost:3000 for local testing.
SITE_URL=https://your-app.onrender.com

# Must match BRIDGE_SECRET set on the server (Render env). Keep it secret.
BRIDGE_SECRET=change-me-to-a-long-random-string

# How this bridge identifies itself in the site timeline (optional).
BRIDGE_ID=home-pi

# Poll interval in ms (default 5000).
POLL_INTERVAL_MS=5000

# ── Printer (real mode). Leave PRINTER_IP empty to run in SIMULATE mode. ──
# Force simulate even with a printer configured: SIMULATE=true
SIMULATE=true

# Bambu P2S on your LAN — from the printer screen (LAN-only / developer mode).
PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=

# Advanced (usually leave as-is):
# PRINTER_PLATE_GCODE=Metadata/plate_1.gcode
# PRINTER_USE_AMS=true
