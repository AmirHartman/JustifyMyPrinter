<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.justifymyprinter.bridge</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/node</string><string>--env-file=/ABSOLUTE/PATH/TO/bridge/.env</string><string>/ABSOLUTE/PATH/TO/bridge/index.js</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO/bridge</string>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/TO/bridge/bridge.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/TO/bridge/bridge.error.log</string>
</dict></plist>
